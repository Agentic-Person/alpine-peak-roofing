    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n          const aiResponse = $json.message || '';\n\n          // Remove all markdown formatting for clean email\n          let cleanText = aiResponse\n            .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')     // Remove bold **text**\n            .replace(/\\*([^*]+)\\*/g, '$1')         // Remove italic *text*\n            .replace(/#{1,6}\\s+/g, '')              // Remove headers ### text\n            .replace(/\\[([^\\]]+)\\]\\([^)]+\\)/g, '$1')  // Clean links [text](url) -> text\n            .replace(/`([^`]+)`/g, '$1')          // Remove code blocks `code`\n            .replace(/^[-*+]\\s+/gm, '• ')           // Clean bullet points\n            .replace(/^\\d+\\.\\s+/gm, '')           // Clean numbered lists\n            .replace(/^>\\s+/gm, '')                 // Remove blockquotes\n            .replace(/\\n{3,}/g, '\\n\\n')           // Clean excessive newlines\n            .replace(/\\\\n/g, '\\n')                // Fix escaped newlines\n            .trim();\n\n          return {\n            json: {\n              email_content: cleanText,\n              email_subject: 'Alpine Peak Roofing - Information About Your Inquiry',\n              user_email: $('Build Prompt1').first()?.json?.user_email || 'jimmydavidson@gmail.com',\n              formatted_for: 'email',\n              timestamp: $json.timestamp\n            }\n          };\n        "
      },
      "type": "n8n-nodes-base.code",
