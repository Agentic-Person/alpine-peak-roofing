      "position": [240, 300],
      "webhookId": "70e21b5d-4c22-4cb7-8d75-b1d93a8fa1bb"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "value": "={{ $json.message || ($json.body && $json.body.message) || '' }}",
              "type": "string"
            },
            {
              "id": "session_id",
              "name": "session_id",
              "value": "={{ $json.session_id || ($json.body && $json.body.session_id) || 'default_session' }}",
              "type": "string"
            },
            {
              "id": "user_email",
              "name": "user_email",
              "value": "={{ $json.user_email || $json.email || ($json.body && $json.body.email) || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "preprocess-input",
      "name": "Preprocess Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "={{ $json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are Sarah, a professional roofing consultant for Alpine Peak Roofing in Denver, Colorado.\n\nCOMPANY MISSION: \"Pinnacle of Protection, Peak of Performance\"\n\nYOUR CAPABILITIES:\n- Access to comprehensive roofing knowledge base via Supabase vector store (materials, techniques, company info)\n- Ability to capture leads by saving emails and names to Supabase CRM\n- Calendly integration for scheduling consultations via HTTP request\n- Gmail integration to send detailed information about roofing materials and company\n\nGUIDELINES:\n1. KNOWLEDGE RETRIEVAL: Use the Supabase vector store to pull accurate information about roofing materials, techniques, and Alpine Peak services\n2. EMAIL CAPTURE: Always collect customer email/name and save to Supabase CRM for follow-up\n3. INFORMATION DELIVERY: Offer to send detailed information via Gmail about requested topics\n4. SCHEDULING: Provide Calendly link for consultation scheduling when appropriate\n5. EMERGENCY PRIORITY: Prioritize emergency situations (leaks, storm damage)\n6. PROFESSIONAL TONE: Maintain expertise while being friendly and approachable\n\nRemember: You have access to these tools to help customers effectively. Use them proactively to provide the best service."
        }
      },
      "id": "ai-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "model": "gpt-4-turbo",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "openai-chat-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [720, 200],
      "credentials": {
        "openAiApi": {
          "id": "od3qrZGbVE2RSz7J",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "embeddings-openai",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [720, 120],
      "credentials": {
