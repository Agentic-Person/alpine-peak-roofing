    {
      "parameters": {
        "jsCode": "// Calculate social media distribution costs and compile results\nconst socialTokens = $('OpenAI - Generate Social Posts').first().json.usage.total_tokens;\nconst socialCost = socialTokens * 0.0015 / 1000; // GPT-3.5 cost\n\n// Distribution results\nconst distributionResults = {\n  nextjs_published: $('HTTP Request - Publish to Next.js').first().json || { success: true },\n  facebook_scheduled: $('HTTP Request - Schedule Facebook Post').first().json || { success: true },\n  linkedin_scheduled: $('HTTP Request - Schedule LinkedIn Post').first().json || { success: true },\n  instagram_scheduled: $('HTTP Request - Schedule Instagram Post').first().json || { success: true },\n  twitter_scheduled: $('HTTP Request - Schedule Twitter Post').first().json || { success: true },\n  google_mybusiness_posted: $('HTTP Request - Google My Business Post').first().json || { success: true }\n};\n\n// Count successful distributions\nconst successfulDistributions = Object.values(distributionResults)\n  .filter(result => result.success !== false).length;\n\nreturn {\n  json: {\n    blog_post_id: $('Supabase - Get Blog Post').first().json.id,\n    social_generation_cost: Math.round(socialCost * 100) / 100,\n    distribution_results: distributionResults,\n    successful_distributions: successfulDistributions,\n    total_distributions: 6,\n    social_tokens_used: socialTokens\n  }\n};"
      },
      "id": "code-distribution-results-001",
      "name": "Code - Process Distribution Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        350
      ]
    },
