      "id": "5e4f6a7b-8c9d-0e1f-2a3b-4c5d6e7f8a9b",
      "name": "Supabase - Recent Customer FAQs",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1.2,
      "position": [
        420,
        500
      ]
    },
    {
      "parameters": {
        "model": "gpt-3.5-turbo",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a roofing content expert for Alpine Peak Roofing in Denver. Based on current season, weather data, industry news, and customer questions, select ONE blog topic that addresses immediate homeowner needs and has seasonal relevance."
            },
            {
              "role": "user",
              "content": "Current date: {{ $now.toFormat('yyyy-MM-dd') }}\nSeason: {{ $now.toFormat('M') > 2 && $now.toFormat('M') < 6 ? 'spring' : $now.toFormat('M') > 5 && $now.toFormat('M') < 9 ? 'summer' : $now.toFormat('M') > 8 && $now.toFormat('M') < 12 ? 'fall' : 'winter' }}\n\nRecent Industry Headlines:\n{{ $('RSS Read - Roofing Industry').all().map(item => '- ' + item.json.title).join('\\n').substring(0, 500) }}\n\nWeather Forecast: {{ $('Weather API - Denver Forecast').first().json.list[0].weather[0].description }} ({{ $('Weather API - Denver Forecast').first().json.list[0].main.temp }}°F)\n\nRecent Customer Topics:\n{{ $('Supabase - Recent Customer FAQs').all().map(item => '- ' + item.json.message).join('\\n').substring(0, 400) }}\n\nSelect ONE blog topic that:\n1. Addresses current homeowner needs\n2. Has seasonal relevance\n3. Hasn't been covered in last 6 months\n4. Can drive lead generation\n\nFormat response as:\nTopic: [Title]\nKeywords: [3-5 target keywords]\nUser Intent: [informational/commercial/navigational]\nContent Type: [seasonal/problem_solving/industry_update]"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 200
        }
      },
      "id": "6f5a7b8c-9d0e-1f2a-3b4c-5d6e7f8a9b0c",
      "name": "OpenAI - Topic Selection",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        620,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse OpenAI response and prepare data for database\nconst response = $input.first().json.choices[0].message.content;\n\n// Extract topic details using regex\nconst topicMatch = response.match(/Topic: (.+)/);\nconst keywordsMatch = response.match(/Keywords: (.+)/);\nconst intentMatch = response.match(/User Intent: (.+)/);\nconst typeMatch = response.match(/Content Type: (.+)/);\n\n// Get current season\nconst currentMonth = new Date().getMonth() + 1;\nlet season;\nif (currentMonth >= 3 && currentMonth <= 5) season = 'spring';\nelse if (currentMonth >= 6 && currentMonth <= 8) season = 'summer';\nelse if (currentMonth >= 9 && currentMonth <= 11) season = 'fall';\nelse season = 'winter';\n\n// Process keywords\nconst keywordsArray = keywordsMatch ? keywordsMatch[1].split(',').map(k => k.trim()) : [];\n\n// Calculate scheduled date (next business day)\nconst scheduledDate = new Date();\nscheduledDate.setDate(scheduledDate.getDate() + 1);\nif (scheduledDate.getDay() === 0) scheduledDate.setDate(scheduledDate.getDate() + 1); // Skip Sunday\nif (scheduledDate.getDay() === 6) scheduledDate.setDate(scheduledDate.getDate() + 2); // Skip Saturday\n\n// Prepare research data\nconst researchData = {\n  rss_headlines: $('RSS Read - Roofing Industry').all().map(item => ({\n    title: item.json.title,\n    link: item.json.link,\n    date: item.json.pubDate\n  })).slice(0, 5),\n  weather_context: {\n    description: $('Weather API - Denver Forecast').first().json.list[0].weather[0].description,\n    temp: $('Weather API - Denver Forecast').first().json.list[0].main.temp,\n    date: new Date().toISOString()\n  },\n  customer_topics: $('Supabase - Recent Customer FAQs').all().map(item => item.json.message).slice(0, 10),\n  selection_reasoning: response\n};\n\nreturn {\n  json: {\n    topic: topicMatch ? topicMatch[1] : 'Denver Roofing Maintenance Guide',\n    keywords: keywordsArray,\n    user_intent: intentMatch ? intentMatch[1].toLowerCase() : 'informational',\n    content_type: typeMatch ? typeMatch[1].toLowerCase() : 'seasonal',\n    season: season,\n    scheduled_for: scheduledDate.toISOString().split('T')[0],\n    research_data: researchData,\n    status: 'pending'\n  }\n};"
      },
      "id": "7a6b8c9d-0e1f-2a3b-4c5d-6e7f8a9b0c1d",
      "name": "Code - Process Topic Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        350
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "blog_content_plans",
        "columns": {
          "values": {
            "topic": "={{ $json.topic }}",
            "keywords": "={{ $json.keywords }}",
            "user_intent": "={{ $json.user_intent }}",
            "content_type": "={{ $json.content_type }}",
            "season": "={{ $json.season }}",
            "scheduled_for": "={{ $json.scheduled_for }}",
            "research_data": "={{ $json.research_data }}",
            "status": "={{ $json.status }}"
          }
        }
      },
      "id": "8b7c9d0e-1f2a-3b4c-5d6e-7f8a9b0c1d2e",
