    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "mode": "id",
          "value": "gpt-3.5-turbo"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a roofing content expert writing for Denver homeowners. Create detailed outlines that are practical, helpful, and drive lead generation."
            },
            {
              "role": "user",
              "content": "Create a detailed outline for: \"{{ $('Supabase - Get Content Plan').first().json.topic }}\"\n\nContent Type: {{ $('Supabase - Get Content Plan').first().json.content_type }}\nTarget Keywords: {{ $('Supabase - Get Content Plan').first().json.keywords.join(', ') }}\nSeason: {{ $('Supabase - Get Content Plan').first().json.season }}\n\nTemplate Structure: {{ $('Supabase - Get Content Template').first().json.structure }}\n\nRequirements:\n- 6-8 main sections\n- Target word count: {{ $('Supabase - Get Content Template').first().json.target_word_count || '1200-1500' }} words\n- Include FAQ section\n- Add safety warnings where relevant\n- List required internal links\n- Focus on Denver market specifics\n\nReturn as JSON with:\n{\n  \"title\": \"SEO-optimized title\",\n  \"sections\": [\n    {\n      \"heading\": \"Section title\",\n      \"content_points\": [\"key point 1\", \"key point 2\"],\n      \"word_target\": 200\n    }\n  ],\n  \"internal_links\": [\"page1\", \"page2\"],\n  \"safety_warnings\": [\"warning text\"],\n  \"faqs\": [\n    {\"question\": \"Q\", \"answer\": \"A\"}\n  ]\n}"
            }
          ]
        },
        "options": {
          "temperature": 0.4,
          "maxTokens": 800
        }
      },
      "id": "openai-outline-001",
      "name": "OpenAI - Create Outline (GPT-3.5)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1020,
        200
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "mode": "id",
          "value": "gpt-3.5-turbo"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Write conversational, helpful roofing content for Denver homeowners. Use 8th grade reading level. Include specific examples and Denver market costs. Be authoritative but approachable."
            },
            {
              "role": "user",
              "content": "Write a complete blog post using this outline: {{ $('OpenAI - Create Outline (GPT-3.5)').first().json.choices[0].message.content }}\n\nTopic: {{ $('Supabase - Get Content Plan').first().json.topic }}\nKeywords to include: {{ $('Supabase - Get Content Plan').first().json.keywords.join(', ') }}\n\nRequirements:\n- Compelling intro addressing homeowner concerns\n- Actionable tips with step-by-step instructions\n- Cost ranges for Denver market\n- Safety warnings where needed\n- Strong CTA for free inspection\n- Natural keyword integration\n- Conversational tone\n- Include local Denver references\n\nTarget length: {{ $('Supabase - Get Content Template').first().json.target_word_count || 1400 }} words"
            }
          ]
        },
        "options": {
          "temperature": 0.6,
          "maxTokens": 2000
        }
      },
      "id": "openai-draft-001",
      "name": "OpenAI - Write Draft (GPT-3.5)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1020,
        350
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "mode": "id",
          "value": "gpt-3.5-turbo"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "Create SEO elements for this blog post:\n\nTitle: {{ JSON.parse($('OpenAI - Create Outline (GPT-3.5)').first().json.choices[0].message.content).title }}\nContent: {{ $('OpenAI - Write Draft (GPT-3.5)').first().json.choices[0].message.content.substring(0, 1000) }}...\n\nCreate:\n1. Meta title (50-60 chars) - include primary keyword\n2. Meta description (150-160 chars) - compelling, includes CTA\n3. 3 internal link suggestions (existing Alpine Peak pages)\n4. Alt text for featured image\n5. URL slug (SEO-friendly)\n6. Focus keyphrases (primary + 2 secondary)\n\nFormat as JSON:\n{\n  \"meta_title\": \"title\",\n  \"meta_description\": \"description\",\n  \"slug\": \"url-friendly-slug\",\n  \"internal_links\": [{\"anchor\": \"text\", \"url\": \"/page\"}],\n  \"featured_image_alt\": \"alt text\",\n  \"focus_keyphrases\": [\"primary\", \"secondary1\", \"secondary2\"]\n}"
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 400
        }
      },
      "id": "openai-seo-001",
      "name": "OpenAI - SEO Optimization (GPT-3.5)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "resource": "image",
        "operation": "generate",
        "model": "dall-e-3",
        "prompt": "Professional photograph of {{ JSON.parse($('OpenAI - Create Outline (GPT-3.5)').first().json.choices[0].message.content).title.toLowerCase().includes('roof') ? 'modern residential roof' : 'roofing maintenance work' }} on a Denver home, bright natural lighting, high quality, realistic, suitable for blog header, professional roofing, Colorado architecture",
        "options": {
          "size": "1792x1024",
          "dalleQuality": "standard"
        }
      },
      "id": "openai-image-001",
      "name": "OpenAI - Generate Featured Image (DALL-E 3)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1220,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process all content and prepare for database\nconst outline = JSON.parse($('OpenAI - Create Outline (GPT-3.5)').first().json.content);\nconst finalContent = $('OpenAI - Write Draft (GPT-3.5)').first().json.content;\nconst seoData = JSON.parse($('OpenAI - SEO Optimization (GPT-3.5)').first().json.content);\nconst imageData = $('OpenAI - Generate Featured Image (DALL-E 3)').first().json;\nconst contentPlan = $('Supabase - Get Content Plan').first().json;\n\n// Calculate total cost (no more GPT-4 polish!)\nconst outlineTokens = $('OpenAI - Create Outline (GPT-3.5)').first().json.usage?.total_tokens || 800;\nconst draftTokens = $('OpenAI - Write Draft (GPT-3.5)').first().json.usage?.total_tokens || 2000;\nconst seoTokens = $('OpenAI - SEO Optimization (GPT-3.5)').first().json.usage?.total_tokens || 400;\n\n// Cost calculation (much cheaper now!)\nconst gpt35Cost = (outlineTokens + draftTokens + seoTokens) * 0.0015 / 1000; // GPT-3.5 cost only\nconst imageCost = 0.080; // DALL-E 3 cost\nconst totalCost = gpt35Cost + imageCost;\n\n// Generate excerpt (first 160 characters of content)\nconst excerpt = finalContent.substring(0, 160).replace(/\\s+$/, '') + '...';\n\n// Create slug from title\nconst slug = seoData.slug || outline.title.toLowerCase()\n  .replace(/[^a-z0-9\\s-]/g, '')\n  .replace(/\\s+/g, '-')\n  .substring(0, 60);\n\nreturn {\n  json: {\n    title: outline.title,\n    slug: slug,\n    content: finalContent,\n    excerpt: excerpt,\n    meta_title: seoData.meta_title,\n    meta_description: seoData.meta_description,\n    featured_image_url: imageData.data?.[0]?.url || 'placeholder-image-url',\n    featured_image_alt: seoData.featured_image_alt,\n    status: 'draft',\n    category: contentPlan.content_type,\n    tags: contentPlan.keywords || [],\n    seo_keywords: seoData.focus_keyphrases || contentPlan.keywords,\n    internal_links: seoData.internal_links || [],\n    ai_generation_cost: Math.round(totalCost * 100) / 100,\n    content_plan_id: contentPlan.id,\n    outline_data: outline,\n    token_usage: {\n      outline: outlineTokens,\n      draft: draftTokens,\n      seo: seoTokens,\n      total: outlineTokens + draftTokens + seoTokens\n    }\n  }\n};"
      },
